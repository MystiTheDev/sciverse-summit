<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <!-- Placeholder for common header items (e.g., meta tags, common CSS links) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    
    <!-- Dark Mode Flash Prevention - MUST execute before body renders -->
    <script>
        // Immediately check and apply saved theme before page renders
        (function() {
            const savedTheme = localStorage.getItem('theme');
            if (savedTheme === 'dark') {
                document.documentElement.classList.add('dark-mode-loading');
            }
        })();
    </script>
    <style>
        /* Apply dark mode immediately if class exists */
        html.dark-mode-loading,
        html.dark-mode-loading body {
            background: #0f172a !important;
            color: #e2e8f0 !important;
        }
    </style>
</head>
<body>

    <!-- ============================================== -->
    <!-- 1. HEADER (NAVBAR) FRAGMENT -->
    <!-- ============================================== -->
    <div th:fragment="header">
        <style>
            /* ================================================
               Apple-Style Floating Glass Morphism Header
               ================================================ */

            /* Floating pill container anchored to the top */
            .apple-glass-header {
                position: fixed !important;
                top: 14px;
                left: 50%;
                transform: translateX(-50%);
                width: calc(100% - 48px);
                max-width: 1480px;
                z-index: 1100;

                /* True glass morphism */
                background: rgba(12, 15, 30, 0.72) !important;
                backdrop-filter: blur(24px) saturate(200%);
                -webkit-backdrop-filter: blur(24px) saturate(200%);

                /* Rounded apple-style corners */
                border-radius: 22px !important;

                /* Layered border — top highlight + full subtle border */
                border: 1px solid rgba(255, 255, 255, 0.13) !important;
                border-top-color: rgba(255, 255, 255, 0.22) !important;

                /* Multi-layer shadow for depth */
                box-shadow:
                    0 24px 60px rgba(0, 0, 0, 0.5),
                    0 6px 20px rgba(0, 0, 0, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.12),
                    inset 0 -1px 0 rgba(0, 0, 0, 0.2) !important;

                padding: 0.45rem 1.25rem;
                transition: box-shadow 0.3s ease, background 0.3s ease;
            }

            .apple-glass-header:hover {
                box-shadow:
                    0 28px 70px rgba(0, 0, 0, 0.55),
                    0 8px 24px rgba(0, 0, 0, 0.35),
                    inset 0 1px 0 rgba(255, 255, 255, 0.16),
                    inset 0 -1px 0 rgba(0, 0, 0, 0.2) !important;
            }

            /* Logo */
            .navbar-brand img {
                height: 42px;
                width: auto;
                filter: drop-shadow(0 0 6px rgba(120, 180, 255, 0.25));
                transition: transform 0.3s ease, filter 0.3s ease;
            }
            .navbar-brand:hover img {
                transform: scale(1.04);
                filter: drop-shadow(0 0 10px rgba(120, 180, 255, 0.45));
            }

            /* Sidebar toggle button */
            .glass-toggler {
                border: 1px solid rgba(255, 255, 255, 0.18);
                background: rgba(255, 255, 255, 0.07);
                color: rgba(255, 255, 255, 0.85);
                border-radius: 10px;
                width: 38px;
                height: 38px;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: all 0.25s ease;
                padding: 0;
            }
            .glass-toggler:hover {
                background: rgba(255, 255, 255, 0.14);
                border-color: rgba(255, 255, 255, 0.3);
                color: #fff;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
            }
            .glass-toggler:active {
                transform: scale(0.95);
            }

            /* User pill / avatar button */
            .user-pill {
                background: rgba(255, 255, 255, 0.09);
                border: 1px solid rgba(255, 255, 255, 0.14);
                border-radius: 50px;
                padding: 0.22rem 0.9rem 0.22rem 0.22rem;
                transition: all 0.25s ease;
                backdrop-filter: blur(8px);
            }
            .user-pill:hover {
                background: rgba(255, 255, 255, 0.16);
                border-color: rgba(255, 255, 255, 0.25);
                box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
            }
            .user-pill .user-avatar {
                background: linear-gradient(135deg, #3b82f6, #6366f1);
                border-radius: 50%;
                width: 30px;
                height: 30px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.85rem;
                box-shadow: 0 2px 8px rgba(99, 102, 241, 0.5);
            }
            .user-pill .user-email {
                font-size: 0.82rem;
                font-weight: 600;
                letter-spacing: 0.01em;
                color: rgba(255, 255, 255, 0.92);
            }
            .user-pill .dropdown-caret {
                font-size: 0.7rem;
                color: rgba(255, 255, 255, 0.5);
                margin-left: 2px;
            }

            /* Dropdown glass panel */
            .dropdown-menu-glass {
                background: rgba(245, 247, 252, 0.75);
                backdrop-filter: blur(28px) saturate(180%);
                -webkit-backdrop-filter: blur(28px) saturate(180%);
                border: 1px solid rgba(255,255,255,0.6);
                border-top-color: rgba(255,255,255,0.9);
                border-radius: 14px;
                box-shadow:
                    0 12px 36px rgba(0,0,0,0.12),
                    inset 0 1px 0 rgba(255,255,255,0.8);
                padding: 6px;
                min-width: 200px;
            }
            .dropdown-menu-glass .dropdown-item {
                color: #334155;
                border-radius: 8px;
                padding: 8px 12px;
                font-size: 0.88rem;
                transition: background 0.15s ease, color 0.15s ease;
            }
            .dropdown-menu-glass .dropdown-item:hover {
                background: rgba(59,130,246,0.08);
                color: #1e293b;
            }
            .dropdown-menu-glass .dropdown-item.text-danger { color: #dc2626; }
            .dropdown-menu-glass .dropdown-item.text-danger:hover {
                background: rgba(239, 68, 68, 0.08);
                color: #b91c1c;
            }
            .dropdown-menu-glass .dropdown-divider {
                border-top-color: rgba(0,0,0,0.08);
                margin: 4px 0;
            }
            /* dark mode: keep the original dark glass */
            body.dark-mode .dropdown-menu-glass {
                background: rgba(14, 18, 38, 0.88) !important;
                border-color: rgba(255,255,255,0.1) !important;
                border-top-color: rgba(255,255,255,0.16) !important;
                box-shadow: 0 16px 48px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.07) !important;
            }
            body.dark-mode .dropdown-menu-glass .dropdown-item { color: #cbd5e1 !important; }
            body.dark-mode .dropdown-menu-glass .dropdown-item:hover { background: rgba(255,255,255,0.09) !important; color: #fff !important; }
            body.dark-mode .dropdown-menu-glass .dropdown-item.text-danger { color: #f87171 !important; }
            body.dark-mode .dropdown-menu-glass .dropdown-item.text-danger:hover { background: rgba(239,68,68,0.14) !important; color: #fca5a5 !important; }
            body.dark-mode .dropdown-menu-glass .dropdown-divider { border-top-color: rgba(255,255,255,0.07) !important; }

            /* Login button (anonymous state) */
            .btn-glass-login {
                background: rgba(59, 130, 246, 0.2);
                border: 1px solid rgba(59, 130, 246, 0.4);
                color: #93c5fd;
                border-radius: 50px;
                padding: 0.35rem 1.1rem;
                font-size: 0.88rem;
                font-weight: 600;
                transition: all 0.25s ease;
                backdrop-filter: blur(8px);
            }
            .btn-glass-login:hover {
                background: rgba(59, 130, 246, 0.35);
                border-color: rgba(59, 130, 246, 0.6);
                color: #fff;
                box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
            }

            /* ── Notification Centre ────────────────────────────── */
            .notif-bell-btn {
                position: relative;
                border: 1px solid rgba(255,255,255,0.13);
                background: rgba(255,255,255,0.07);
                color: rgba(255,255,255,0.6);
                border-radius: 10px;
                width: 38px; height: 38px;
                display: flex; align-items: center; justify-content: center;
                cursor: pointer; transition: all .22s ease;
                padding: 0;
            }
            .notif-bell-btn:hover {
                background: rgba(255,255,255,0.14);
                border-color: rgba(255,255,255,0.26);
                color: #fff;
                box-shadow: 0 2px 8px rgba(0,0,0,0.25);
            }
            .notif-bell-btn.has-notif {
                color: #fbbf24;
            }
            .notif-bell-btn.has-notif:hover { color: #fde68a; }
            /* Count badge on the bell */
            .notif-count-badge {
                display: none;
                position: absolute;
                top: -4px; right: -5px;
                background: #ef4444;
                color: #fff;
                font-size: 0.6rem;
                font-weight: 700;
                min-width: 16px; height: 16px;
                border-radius: 50px;
                padding: 0 3px;
                align-items: center; justify-content: center;
                border: 1.5px solid rgba(10,15,30,0.7);
                line-height: 1;
            }
            /* Live running dot (no badge, just a small teal dot) */
            .notif-live-dot {
                display: none;
                position: absolute;
                top: 3px; right: 3px;
                width: 7px; height: 7px;
                border-radius: 50%;
                background: #10b981;
                border: 1.5px solid rgba(10,15,30,0.7);
                animation: ntb-pulse 1.5s ease-in-out infinite;
            }
            /* Dropdown panel */
            .notif-dropdown {
                position: absolute;
                top: calc(100% + 12px);
                right: 0;
                width: 320px;
                background: #f5f7fc;
                border: 1px solid #d1d9e4;
                border-radius: 18px;
                box-shadow: 0 16px 48px rgba(0,0,0,0.14), 0 2px 8px rgba(0,0,0,0.08);
                z-index: 5000;
                overflow: hidden;
                animation: gtf-in .22s cubic-bezier(.175,.885,.32,1.275) both;
            }
            /* Header row */
            .notif-dd-hdr {
                display: flex; align-items: center;
                justify-content: space-between;
                padding: 14px 16px 10px;
                border-bottom: 1px solid rgba(0,0,0,0.07);
            }
            .notif-dd-title {
                font-size: 0.88rem; font-weight: 700;
                color: #1e293b; letter-spacing: 0.01em;
            }
            .notif-dd-title i { margin-right: 6px; font-size: 0.92rem; opacity: .8; }
            .notif-dd-clear {
                font-size: 0.72rem; font-weight: 600;
                color: #94a3b8; cursor: pointer;
                background: none; border: none; padding: 3px 8px;
                border-radius: 6px; transition: all .15s;
            }
            .notif-dd-clear:hover { color: #ef4444; background: rgba(239,68,68,0.08); }
            /* Scrollable list */
            .notif-dd-list {
                max-height: 420px;
                overflow-y: auto;
                padding: 8px 8px;
                display: flex; flex-direction: column; gap: 6px;
            }
            .notif-dd-list::-webkit-scrollbar { width: 5px; }
            .notif-dd-list::-webkit-scrollbar-track { background: transparent; }
            .notif-dd-list::-webkit-scrollbar-thumb { background: rgba(0,0,0,0.15); border-radius: 10px; }
            /* Dark mode: keep original dark glass */
            body.dark-mode .notif-dropdown {
                background: rgba(8,12,28,0.92) !important;
                border-color: rgba(255,255,255,0.08) !important;
                border-top-color: rgba(255,255,255,0.16) !important;
                box-shadow: 0 20px 56px rgba(0,0,0,0.65), 0 0 0 1px rgba(255,255,255,0.03) !important;
            }
            body.dark-mode .notif-dd-hdr { border-bottom-color: rgba(255,255,255,0.07) !important; }
            body.dark-mode .notif-dd-title { color: rgba(255,255,255,0.92) !important; }
            body.dark-mode .notif-dd-clear { color: rgba(255,255,255,0.35) !important; }
            body.dark-mode .notif-dd-clear:hover { color: #f87171 !important; background: rgba(239,68,68,0.12) !important; }
            body.dark-mode .notif-dd-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); }
            /* Notification card dark mode — restore white-on-dark colors */
            body.dark-mode .notif-empty { color: rgba(255,255,255,0.3) !important; }
            body.dark-mode .notif-card { background: rgba(255,255,255,0.05) !important; border-color: rgba(255,255,255,0.07) !important; }
            body.dark-mode .notif-card:hover { background: rgba(255,255,255,0.08) !important; }
            body.dark-mode .notif-card-icon.timer-icon { color: #6ee7b7 !important; }
            body.dark-mode .notif-card-icon.paused-icon { color: #94a3b8 !important; }
            body.dark-mode .notif-card-label { color: rgba(255,255,255,0.85) !important; }
            body.dark-mode .notif-card-sub { color: rgba(255,255,255,0.38) !important; }
            body.dark-mode .notif-card-goto { color: rgba(255,255,255,0.28) !important; }
            body.dark-mode .notif-card-goto:hover { color: #fff !important; background: rgba(255,255,255,0.1) !important; }
            body.dark-mode .notif-card-time { color: #fff !important; }
            body.dark-mode .notif-card-bar { background: rgba(255,255,255,0.07) !important; }
            body.dark-mode .notif-act-btn { border-color: rgba(255,255,255,0.10) !important; background: rgba(255,255,255,0.06) !important; color: rgba(255,255,255,0.78) !important; }
            body.dark-mode .notif-act-btn:hover { background: rgba(255,255,255,0.13) !important; color: #fff !important; border-color: rgba(255,255,255,0.2) !important; }
            body.dark-mode .notif-act-btn.reset-act { color: #fca5a5 !important; }
            body.dark-mode .notif-act-btn.reset-act:hover { color: #fecaca !important; }
            /* Empty state */
            .notif-empty {
                display: flex; flex-direction: column;
                align-items: center; justify-content: center;
                gap: 8px; padding: 32px 16px;
                color: #94a3b8;
            }
            .notif-empty i { font-size: 2.2rem; opacity: .5; }
            .notif-empty span { font-size: 0.82rem; font-weight: 500; }
            /* ── Notification card (generic) ── */
            .notif-card {
                background: rgba(0,0,0,0.03);
                border: 1px solid rgba(0,0,0,0.07);
                border-radius: 12px;
                padding: 12px 13px;
                transition: background .15s;
            }
            .notif-card:hover { background: rgba(0,0,0,0.05); }
            /* Card top row */
            .notif-card-top {
                display: flex; align-items: flex-start; gap: 10px;
                margin-bottom: 10px;
            }
            .notif-card-icon {
                width: 32px; height: 32px; border-radius: 9px;
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0; font-size: 0.95rem;
            }
            .notif-card-icon.timer-icon {
                background: rgba(16,185,129,0.18);
                color: #059669;
            }
            .notif-card-icon.paused-icon {
                background: rgba(100,116,139,0.18);
                color: #64748b;
            }
            .notif-card-meta { flex: 1; min-width: 0; }
            .notif-card-label {
                font-size: 0.78rem; font-weight: 700;
                color: #1e293b;
                white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            }
            .notif-card-sub {
                font-size: 0.7rem; color: #64748b;
                margin-top: 1px; font-weight: 500;
            }
            .notif-card-goto {
                color: #94a3b8; font-size: 0.85rem;
                text-decoration: none; padding: 4px; border-radius: 6px;
                transition: all .14s; flex-shrink: 0;
            }
            .notif-card-goto:hover { color: #1e293b; background: rgba(0,0,0,0.06); }
            /* Timer big display inside card */
            .notif-card-time {
                font-family: 'SF Mono','Consolas',monospace;
                font-size: 1.8rem; font-weight: 700; color: #1e293b;
                text-align: center; letter-spacing: 0.04em;
                margin-bottom: 8px; line-height: 1;
            }
            .notif-card-bar {
                height: 3px; background: rgba(0,0,0,0.08);
                border-radius: 3px; overflow: hidden; margin-bottom: 10px;
            }
            .notif-card-fill {
                height: 100%; border-radius: 3px; background: #10b981;
                transition: width 1s linear, background .5s;
            }
            .notif-card-actions {
                display: flex; gap: 6px;
            }
            .notif-act-btn {
                flex: 1;
                border: 1px solid rgba(0,0,0,0.09);
                background: rgba(0,0,0,0.04);
                color: #475569;
                border-radius: 8px; padding: 6px 4px;
                font-size: 0.82rem; cursor: pointer; transition: all .15s;
                display: flex; align-items: center; justify-content: center; gap: 5px;
            }
            .notif-act-btn:hover { background:rgba(0,0,0,0.07); color:#1e293b; border-color:rgba(0,0,0,0.15); }
            .notif-act-btn.reset-act {
                background: rgba(239,68,68,0.08); border-color:rgba(239,68,68,0.18);
                color: #991b1b; flex: 0.7;
            }
            .notif-act-btn.reset-act:hover { background:rgba(239,68,68,0.18); color:#7f1d1d; }
            .notif-act-btn.expand-act {
                font-size: 0.7rem; font-weight: 600; letter-spacing: .02em;
            }

            /* ── Float window minimize button ───────────────── */
            .gtf-minimize-btn {
                color: rgba(255,255,255,0.38); font-size: 1rem;
                background: none; border: none; padding: 2px 5px;
                border-radius: 6px; cursor: pointer;
                transition: all .15s; line-height: 1;
            }
            .gtf-minimize-btn:hover { color:rgba(255,255,255,0.9); background:rgba(255,255,255,0.08); }
            @keyframes ntb-pulse {
                0%,100% { opacity:1; transform:scale(1); }
                50%      { opacity:.4; transform:scale(.65); }
            }

            /* ── Timer-Ended Toast ─────────────────────────────── */
            .timer-ended-toast {
                position: fixed;
                top: 80px;
                left: 50%;
                transform: translateX(-50%) translateY(-20px);
                z-index: 99999;
                min-width: 320px;
                max-width: 440px;
                background: rgba(8, 12, 28, 0.97);
                backdrop-filter: blur(28px) saturate(180%);
                -webkit-backdrop-filter: blur(28px) saturate(180%);
                border: 1px solid rgba(255,255,255,0.10);
                border-top: 2px solid #10b981;
                border-radius: 18px;
                box-shadow: 0 24px 64px rgba(0,0,0,0.7), 0 0 0 1px rgba(255,255,255,0.04),
                            0 0 40px rgba(16,185,129,0.12);
                padding: 18px 20px 16px;
                opacity: 0;
                pointer-events: none;
                transition: opacity .35s ease, transform .35s cubic-bezier(.175,.885,.32,1.275);
            }
            .timer-ended-toast.visible {
                opacity: 1;
                pointer-events: auto;
                transform: translateX(-50%) translateY(0);
            }
            .tet-top {
                display: flex; align-items: flex-start; gap: 13px; margin-bottom: 12px;
            }
            .tet-icon-ring {
                width: 44px; height: 44px; border-radius: 14px;
                background: rgba(16,185,129,0.18);
                border: 1px solid rgba(16,185,129,0.3);
                display: flex; align-items: center; justify-content: center;
                flex-shrink: 0;
                font-size: 1.3rem; color: #6ee7b7;
                animation: tet-ring-pulse 1s ease-in-out 3;
            }
            @keyframes tet-ring-pulse {
                0%,100% { box-shadow: 0 0 0 0 rgba(16,185,129,0); }
                50%     { box-shadow: 0 0 0 8px rgba(16,185,129,0.22); }
            }
            .tet-text { flex: 1; min-width: 0; }
            .tet-title {
                font-size: 0.95rem; font-weight: 700;
                color: rgba(255,255,255,0.95); letter-spacing: 0.01em;
                margin-bottom: 3px;
            }
            .tet-sub {
                font-size: 0.78rem; color: rgba(255,255,255,0.45); font-weight: 500;
            }
            .tet-dismiss {
                background: none; border: none; padding: 4px 6px;
                color: rgba(255,255,255,0.28); font-size: 1rem; cursor: pointer;
                border-radius: 7px; transition: all .15s; line-height: 1;
                flex-shrink: 0;
            }
            .tet-dismiss:hover { color: #fff; background: rgba(255,255,255,0.1); }
            .tet-bar {
                height: 3px; border-radius: 3px;
                background: rgba(255,255,255,0.07); overflow: hidden;
            }
            .tet-bar-fill {
                height: 100%; border-radius: 3px;
                background: linear-gradient(90deg, #10b981, #6ee7b7);
                width: 100%;
                transition: width linear;
            }
            .tet-actions {
                display: flex; gap: 8px; margin-top: 12px;
            }
            .tet-btn {
                flex: 1; padding: 8px 12px;
                border: 1px solid rgba(255,255,255,0.10);
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.78); border-radius: 10px;
                font-size: 0.8rem; font-weight: 600; cursor: pointer;
                transition: all .15s;
                display: flex; align-items: center; justify-content: center; gap: 6px;
            }
            .tet-btn:hover { background: rgba(255,255,255,0.12); color: #fff; border-color: rgba(255,255,255,0.2); }
            .tet-btn-primary {
                background: rgba(16,185,129,0.18);
                border-color: rgba(16,185,129,0.3);
                color: #6ee7b7;
            }
            .tet-btn-primary:hover { background: rgba(16,185,129,0.3); color: #fff; }
            .global-timer-float {
                position: fixed;
                bottom: 24px;
                right: 24px;
                z-index: 9999;
                width: 228px;
                background: rgba(10,15,30,0.9);
                backdrop-filter: blur(24px) saturate(180%);
                -webkit-backdrop-filter: blur(24px) saturate(180%);
                border: 1px solid rgba(255,255,255,0.09);
                border-top-color: rgba(255,255,255,0.16);
                border-radius: 18px;
                box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04);
                display: none;
                flex-direction: column;
                overflow: hidden;
                animation: gtf-in .32s cubic-bezier(.175,.885,.32,1.275) both;
            }
            @keyframes gtf-in {
                from { opacity:0; transform:translateY(18px) scale(.95); }
                to   { opacity:1; transform:translateY(0) scale(1); }
            }
            .gtf-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 10px 14px 8px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }
            .gtf-title {
                display: flex;
                align-items: center;
                gap: 7px;
                font-size: 0.72rem;
                font-weight: 700;
                color: rgba(255,255,255,0.6);
                letter-spacing: 0.07em;
                text-transform: uppercase;
            }
            .gtf-pulse-dot {
                width: 7px; height: 7px;
                border-radius: 50%;
                background: #10b981;
                flex-shrink: 0;
                animation: ntb-pulse 1.6s ease-in-out infinite;
            }
            .gtf-paused .gtf-pulse-dot { background:#64748b; animation:none; }
            .gtf-goto {
                color: rgba(255,255,255,0.38);
                font-size: 0.9rem;
                text-decoration: none;
                transition: all 0.15s;
                padding: 2px 5px;
                border-radius: 6px;
            }
            .gtf-goto:hover {
                color: rgba(255,255,255,0.9);
                background: rgba(255,255,255,0.08);
            }
            .gtf-body   { padding: 8px 14px 4px; }
            .gtf-time {
                font-family: 'SF Mono','Consolas',monospace;
                font-size: 2.1rem;
                font-weight: 700;
                color: #fff;
                text-align: center;
                letter-spacing: 0.05em;
                line-height: 1.1;
                margin-bottom: 9px;
            }
            .gtf-progress {
                height: 4px;
                background: rgba(255,255,255,0.08);
                border-radius: 4px;
                overflow: hidden;
            }
            .gtf-progress-fill {
                height: 100%;
                border-radius: 4px;
                width: 100%;
                background: #10b981;
                transition: width 1s linear, background .5s ease;
            }
            .gtf-footer {
                display: flex;
                justify-content: center;
                gap: 8px;
                padding: 9px 14px 12px;
                border-top: 1px solid rgba(255,255,255,0.06);
            }
            .gtf-btn {
                flex: 1;
                border: 1px solid rgba(255,255,255,0.11);
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.8);
                border-radius: 10px;
                padding: 7px 6px;
                font-size: 1rem;
                cursor: pointer;
                transition: all .18s;
            }
            .gtf-btn:hover {
                background: rgba(255,255,255,0.13);
                border-color: rgba(255,255,255,0.2);
                color: #fff;
            }
            .gtf-btn:active { transform:scale(.94); }
            .gtf-btn-reset {
                background: rgba(239,68,68,0.1);
                border-color: rgba(239,68,68,0.22);
                color: #fca5a5;
                flex: 0.6;
            }
            .gtf-btn-reset:hover {
                background: rgba(239,68,68,0.2);
                border-color: rgba(239,68,68,0.4);
                color: #fecaca;
            }

            /* ── Notification Bell ────────────────────────────────── */
            .notif-active-dot {
                position: absolute;
                top: 4px; right: 4px;
                width: 8px; height: 8px;
                border-radius: 50%;
                background: #10b981;
                border: 1.5px solid rgba(10,15,30,0.6);
                animation: ntb-pulse 1.6s ease-in-out infinite;
            }
            .notif-panel {
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                width: 238px;
                background: rgba(10,15,30,0.97);
                backdrop-filter: blur(24px) saturate(180%);
                -webkit-backdrop-filter: blur(24px) saturate(180%);
                border: 1px solid rgba(255,255,255,0.10);
                border-top-color: rgba(255,255,255,0.18);
                border-radius: 16px;
                box-shadow: 0 16px 48px rgba(0,0,0,0.55);
                z-index: 5000;
                overflow: hidden;
                animation: gtf-in .22s cubic-bezier(.175,.885,.32,1.275) both;
            }
            .notif-panel-hdr {
                display: flex; align-items: center;
                justify-content: space-between;
                padding: 10px 14px 8px;
                border-bottom: 1px solid rgba(255,255,255,0.07);
            }
            .notif-panel-dot {
                width: 7px; height: 7px;
                border-radius: 50%; background: #10b981; flex-shrink: 0;
            }
            .notif-panel-lbl {
                font-size: 0.72rem; font-weight: 700;
                color: rgba(255,255,255,0.65);
                letter-spacing: 0.07em; text-transform: uppercase;
            }
            .notif-goto-link {
                color: rgba(255,255,255,0.35); font-size: 0.85rem;
                text-decoration: none; padding: 3px 6px;
                border-radius: 6px; transition: all .15s;
            }
            .notif-goto-link:hover { color:#fff; background:rgba(255,255,255,0.1); }
            .notif-panel-time {
                font-family: 'SF Mono','Consolas',monospace;
                font-size: 2.1rem; font-weight: 700; color: #fff;
                text-align: center; letter-spacing: 0.04em;
                padding: 10px 14px 6px;
            }
            .notif-panel-bar {
                height: 3px; background: rgba(255,255,255,0.07);
                margin: 0 14px 10px; border-radius: 3px; overflow: hidden;
            }
            .notif-panel-fill {
                height: 100%; border-radius: 3px; background: #10b981;
                transition: width 1s linear, background .5s;
            }
            .notif-panel-controls {
                display: flex; gap: 6px;
                padding: 6px 14px 12px;
                border-top: 1px solid rgba(255,255,255,0.06);
            }
            .notif-ctrl-btn {
                flex: 1;
                border: 1px solid rgba(255,255,255,0.11);
                background: rgba(255,255,255,0.06);
                color: rgba(255,255,255,0.8);
                border-radius: 9px; padding: 7px 4px;
                font-size: 0.9rem; cursor: pointer; transition: all .15s;
            }
            .notif-ctrl-btn:hover { background:rgba(255,255,255,0.13); color:#fff; border-color:rgba(255,255,255,0.2); }
            .notif-expand-btn { font-size:0.7rem; font-weight:600; flex:1.4; letter-spacing:.02em; }

            /* ── Float window minimize button ───────────────── */
            .gtf-minimize-btn {
                color: rgba(255,255,255,0.38); font-size: 1rem;
                background: none; border: none; padding: 2px 5px;
                border-radius: 6px; cursor: pointer;
                transition: all .15s; line-height: 1;
            }
            .gtf-minimize-btn:hover { color:rgba(255,255,255,0.9); background:rgba(255,255,255,0.08); }

            /* ================================================
               NAVBAR THEME TOGGLE PILL
               (duplicated here so it works on pages that don't
                include the sidebar fragment, e.g. dashboard)
               ================================================ */
            .theme-toggle-pill {
                display: flex; align-items: center; gap: 7px;
                background: rgba(255,255,255,0.08);
                border: 1px solid rgba(255,255,255,0.14);
                border-radius: 50px; padding: 5px 10px;
                cursor: pointer; transition: all 0.25s;
                user-select: none; -webkit-user-select: none;
            }
            .theme-toggle-pill:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.25); }
            .theme-icon-sun  { font-size: 0.78rem; color: #fbbf24; transition: all 0.25s; }
            .theme-icon-moon { font-size: 0.78rem; color: rgba(255,255,255,0.35); transition: all 0.25s; }
            body.dark-mode .theme-icon-sun  { color: rgba(255,255,255,0.3); }
            body.dark-mode .theme-icon-moon { color: #a5b4fc; }
            .theme-toggle-track {
                position: relative; width: 32px; height: 18px;
                background: rgba(255,255,255,0.18); border-radius: 50px;
                transition: background 0.25s; display: inline-block;
            }
            .theme-toggle-thumb {
                position: absolute; top: 3px; left: 3px;
                width: 12px; height: 12px;
                background: #fff; border-radius: 50%; transition: transform 0.25s; display: block;
            }
            body.dark-mode .theme-toggle-track { background: #6366f1; }
            body.dark-mode .theme-toggle-thumb { transform: translateX(14px); }
        </style>

        <nav class="navbar navbar-expand-lg navbar-dark apple-glass-header">
            <div class="container-fluid px-1">
                <!-- Toggle Button for Sidebar -->
                <button class="btn glass-toggler me-3" type="button" 
                        id="sidebarToggleBtn"
                        aria-label="Toggle navigation">
                    <i class="bi bi-list fs-5"></i>
                </button>
                
                <!-- Brand Text -->
                <a class="navbar-brand p-0 fw-bold" href="/" style="font-size: 1.1rem; letter-spacing: 0.02em; color: #fff;">
                    SciVerse Summit
                </a>

                <div class="ms-auto d-flex align-items-center gap-2">

                    <!-- ── Notification Centre (always visible) ── -->
                    <div id="notifBellWrapper" class="position-relative">

                        <!-- Bell button -->
                        <button class="notif-bell-btn" id="notifBellBtn"
                                title="Notifications" aria-label="Notifications">
                            <i class="bi bi-bell-fill" id="notifBellIcon" style="font-size:1rem;"></i>
                            <!-- Red badge: unread count -->
                            <span class="notif-count-badge" id="notifCountBadge">1</span>
                            <!-- Teal live dot: running timer -->
                            <span class="notif-live-dot" id="notifLiveDot"></span>
                        </button>

                        <!-- Notification dropdown -->
                        <div class="notif-dropdown" id="notifPanel" style="display:none;">

                            <!-- Header -->
                            <div class="notif-dd-hdr">
                                <div class="notif-dd-title">
                                    <i class="bi bi-bell-fill"></i>Notifications
                                </div>
                                <button class="notif-dd-clear" id="notifClearBtn"
                                        title="Dismiss all">Clear all</button>
                            </div>

                            <!-- Notification list -->
                            <div class="notif-dd-list" id="notifList">

                                <!-- Empty state (shown when no notifications) -->
                                <div class="notif-empty" id="notifEmptyState">
                                    <i class="bi bi-bell-slash"></i>
                                    <span>No notifications</span>
                                </div>

                                <!-- Timer cards rendered dynamically (one per active timer) -->
                                <div id="notifCardsList"></div>

                            </div>
                        </div>
                    </div>

                    <!-- Theme Toggle Pill -->
                    <div class="theme-toggle-pill" id="navThemeToggle"
                         onclick="setTheme(document.body.classList.contains('dark-mode') ? 'light' : 'dark')"
                         title="Toggle dark / light mode" role="button" aria-label="Toggle theme">
                        <i class="bi bi-sun-fill theme-icon-sun"></i>
                        <span class="theme-toggle-track"><span class="theme-toggle-thumb"></span></span>
                        <i class="bi bi-moon-stars-fill theme-icon-moon"></i>
                    </div>

                    <!-- Authenticated User: Show Email Dropdown -->
                    <div sec:authorize="isAuthenticated()" class="dropdown">
                        <button class="btn text-white dropdown-toggle user-pill d-flex align-items-center gap-2"
                                type="button" id="userDropdown"
                                data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar">
                                <i class="bi bi-person-fill text-white"></i>
                            </div>
                            <span th:text="${currentUserEmail}" class="user-email">user@example.com</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end dropdown-menu-glass mt-2"
                            aria-labelledby="userDropdown">
                            <li>
                                <button type="button" class="dropdown-item"
                                        data-bs-toggle="modal" data-bs-target="#preferencesModal">
                                    <i class="bi bi-gear-fill me-2 opacity-75"></i>Settings
                                </button>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button type="button" class="dropdown-item text-danger"
                                        data-bs-toggle="modal" data-bs-target="#logoutModal">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </button>
                            </li>
                        </ul>
                    </div>

                    <!-- Anonymous User: Show Login Link -->
                    <a sec:authorize="!isAuthenticated()" class="btn-glass-login" href="/login">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Login
                    </a>
                </div>
            </div>
        </nav>

        <!-- Logout Confirmation Modal -->
        <div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="logoutModalLabel">Confirm Logout</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to log out?
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <form th:action="@{/logout}" method="post" style="display: inline;">
                            <button type="submit" class="btn btn-danger">Logout</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Settings Modal -->
        <div class="modal fade" id="preferencesModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered settings-modal-dialog">
                <div class="modal-content settings-modal-content border-0">

                    <!-- Modal Header -->
                    <div class="settings-modal-header">
                        <div class="d-flex align-items-center gap-3">
                            <div class="settings-header-icon">
                                <i class="bi bi-sliders2"></i>
                            </div>
                            <div>
                                <div class="settings-modal-title" id="settingsModalLabel">Settings</div>
                                <div class="settings-modal-subtitle">Customize your SciVerse Summit experience</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close settings-close-btn" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <!-- Two-column body -->
                    <div class="settings-modal-body">

                        <!-- Left: Category Nav -->
                        <nav class="settings-nav">
                            <button class="settings-cat-btn active" data-panel="appearance" onclick="switchSettingsPanel('appearance')">
                                <span class="stg-nav-icon" style="background:linear-gradient(135deg,#3b82f6,#6366f1);"><i class="bi bi-display"></i></span><span>Appearance</span>
                            </button>
                            <button class="settings-cat-btn" data-panel="notifications" onclick="switchSettingsPanel('notifications')">
                                <span class="stg-nav-icon" style="background:linear-gradient(135deg,#10b981,#059669);"><i class="bi bi-bell-fill"></i></span><span>Notifications</span>
                            </button>
                            <button class="settings-cat-btn" data-panel="timers" onclick="switchSettingsPanel('timers')">
                                <span class="stg-nav-icon" style="background:linear-gradient(135deg,#f59e0b,#d97706);"><i class="bi bi-stopwatch-fill"></i></span><span>Timers</span>
                            </button>
                            <button class="settings-cat-btn" data-panel="session" onclick="switchSettingsPanel('session')">
                                <span class="stg-nav-icon" style="background:linear-gradient(135deg,#8b5cf6,#7c3aed);"><i class="bi bi-building-fill"></i></span><span>Session</span>
                            </button>
                            <button class="settings-cat-btn" data-panel="data" onclick="switchSettingsPanel('data')">
                                <span class="stg-nav-icon" style="background:linear-gradient(135deg,#ef4444,#dc2626);"><i class="bi bi-shield-lock-fill"></i></span><span>Data &amp; Privacy</span>
                            </button>
                            <button class="settings-cat-btn" data-panel="account" onclick="switchSettingsPanel('account')">
                                <span class="stg-nav-icon" style="background:linear-gradient(135deg,#64748b,#475569);"><i class="bi bi-person-fill"></i></span><span>Account</span>
                            </button>
                            <div class="settings-nav-divider"></div>
                            <button class="settings-cat-btn" data-panel="about" onclick="switchSettingsPanel('about')">
                                <span class="stg-nav-icon" style="background:linear-gradient(135deg,#0ea5e9,#0284c7);"><i class="bi bi-info-lg"></i></span><span>About</span>
                            </button>
                        </nav>

                        <!-- Right: Content Panels -->
                        <div class="settings-panels">

                            <!-- APPEARANCE -->
                            <div class="settings-panel active" id="stg-panel-appearance">
                                <div class="stg-section-title"><i class="bi bi-palette-fill me-2"></i>Appearance</div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-fonts me-2" style="color:#3b82f6;"></i>Interface Font Size</div>
                                        <div class="stg-row-desc">Adjust the text size across the application</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <div class="stg-segmented">
                                            <button class="stg-seg-btn" data-stg-key="fontSize" data-stg-val="small" onclick="saveSetting('fontSize','small')">Small</button>
                                            <button class="stg-seg-btn" data-stg-key="fontSize" data-stg-val="medium" onclick="saveSetting('fontSize','medium')">Medium</button>
                                            <button class="stg-seg-btn" data-stg-key="fontSize" data-stg-val="large" onclick="saveSetting('fontSize','large')">Large</button>
                                        </div>
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-lightning-fill me-2" style="color:#f59e0b;"></i>Reduce Animations</div>
                                        <div class="stg-row-desc">Minimize motion for a calmer experience</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <div class="stg-toggle-switch">
                                            <input type="checkbox" id="stg-reduceAnimations" data-stg-key="reduceAnimations" onchange="saveSetting('reduceAnimations', this.checked)">
                                            <label for="stg-reduceAnimations" class="stg-toggle-label"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- NOTIFICATIONS -->
                            <div class="settings-panel" id="stg-panel-notifications">
                                <div class="stg-section-title"><i class="bi bi-bell-fill me-2"></i>Notifications</div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-music-note-beamed me-2" style="color:#10b981;"></i>Timer End Chime</div>
                                        <div class="stg-row-desc">Play a sound when any timer reaches zero</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <div class="stg-toggle-switch">
                                            <input type="checkbox" id="stg-chimeEnabled" data-stg-key="chimeEnabled" onchange="saveSetting('chimeEnabled', this.checked)">
                                            <label for="stg-chimeEnabled" class="stg-toggle-label"></label>
                                        </div>
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-speaker-fill me-2" style="color:#6366f1;"></i>Chime Volume</div>
                                        <div class="stg-row-desc">Loudness of the timer-end chime</div>
                                    </div>
                                    <div class="stg-row-ctrl d-flex align-items-center gap-2">
                                        <input type="range" class="stg-range-input" id="stg-chimeVolume"
                                               min="0" max="100" step="5"
                                               data-stg-key="chimeVolume"
                                               oninput="saveSetting('chimeVolume', parseInt(this.value)); document.getElementById('stg-chimeVolumeVal').textContent = this.value + '%'">
                                        <span id="stg-chimeVolumeVal" style="font-size:0.78rem;color:#64748b;min-width:34px;text-align:right;">70%</span>
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-chat-square-fill me-2" style="color:#3b82f6;"></i>Timer End Toast</div>
                                        <div class="stg-row-desc">Show a popup notification when a timer ends</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <div class="stg-toggle-switch">
                                            <input type="checkbox" id="stg-toastEnabled" data-stg-key="toastEnabled" onchange="saveSetting('toastEnabled', this.checked)">
                                            <label for="stg-toastEnabled" class="stg-toggle-label"></label>
                                        </div>
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-hourglass-split me-2" style="color:#f59e0b;"></i>Toast Duration</div>
                                        <div class="stg-row-desc">How long the timer-end popup stays visible</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <div class="stg-segmented">
                                            <button class="stg-seg-btn" data-stg-key="toastDuration" data-stg-val="5" onclick="saveSetting('toastDuration', 5)">5s</button>
                                            <button class="stg-seg-btn" data-stg-key="toastDuration" data-stg-val="8" onclick="saveSetting('toastDuration', 8)">8s</button>
                                            <button class="stg-seg-btn" data-stg-key="toastDuration" data-stg-val="12" onclick="saveSetting('toastDuration', 12)">12s</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- TIMERS -->
                            <div class="settings-panel" id="stg-panel-timers">
                                <div class="stg-section-title"><i class="bi bi-stopwatch-fill me-2"></i>Timers</div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-mic-fill me-2" style="color:#3b82f6;"></i>Default Speaker Time</div>
                                        <div class="stg-row-desc">Pre-filled duration for the Speaker Timer (seconds)</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <input type="number" class="stg-number-input" min="10" max="600" step="5"
                                               id="stg-defaultSpeakerTime" data-stg-key="defaultSpeakerTime"
                                               onchange="saveSetting('defaultSpeakerTime', parseInt(this.value) || 90)">
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-people-fill me-2" style="color:#8b5cf6;"></i>Default Segment Time</div>
                                        <div class="stg-row-desc">Pre-filled duration for the Segment Timer (seconds)</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <input type="number" class="stg-number-input" min="30" max="3600" step="30"
                                               id="stg-defaultSegmentTime" data-stg-key="defaultSegmentTime"
                                               onchange="saveSetting('defaultSegmentTime', parseInt(this.value) || 300)">
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-clock-fill me-2" style="color:#10b981;"></i>Default Kolloqium Time</div>
                                        <div class="stg-row-desc">Pre-filled duration for the Kolloqium Timer (seconds)</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <input type="number" class="stg-number-input" min="60" max="7200" step="60"
                                               id="stg-defaultKolloqiumTime" data-stg-key="defaultKolloqiumTime"
                                               onchange="saveSetting('defaultKolloqiumTime', parseInt(this.value) || 600)">
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-music-note-list me-2" style="color:#f59e0b;"></i>Timer Sound Style</div>
                                        <div class="stg-row-desc">Choose the chime melody that plays when a timer ends</div>
                                    </div>
                                    <div class="stg-row-ctrl" style="display:flex;flex-direction:column;align-items:flex-end;gap:7px;">
                                        <div class="stg-segmented">
                                            <button class="stg-seg-btn" data-stg-key="chimeStyle" data-stg-val="bell"   onclick="saveSetting('chimeStyle','bell');   this.closest('.stg-segmented').querySelectorAll('.stg-seg-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active');">&#127895; Bell</button>
                                            <button class="stg-seg-btn" data-stg-key="chimeStyle" data-stg-val="alarm"  onclick="saveSetting('chimeStyle','alarm');  this.closest('.stg-segmented').querySelectorAll('.stg-seg-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active');">&#128680; Alarm</button>
                                            <button class="stg-seg-btn" data-stg-key="chimeStyle" data-stg-val="pulse"  onclick="saveSetting('chimeStyle','pulse');  this.closest('.stg-segmented').querySelectorAll('.stg-seg-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active');">&#128165; Pulse</button>
                                        </div>
                                        <button class="stg-preview-btn"
                                                onclick="(function(){try{if(window._audioCtx&&window._audioCtx.state==='suspended'){window._audioCtx.resume().then(function(){window._playTimerEndChime();});}else{window._playTimerEndChime();}}catch(e){}})()">
                                            <i class="bi bi-play-circle-fill"></i> Preview
                                        </button>
                                    </div>
                                </div>
                                <div class="stg-row">
                                    <div class="stg-row-info">
                                        <div class="stg-row-label"><i class="bi bi-repeat me-2" style="color:#6366f1;"></i>Sound Repeats</div>
                                        <div class="stg-row-desc">How many times the chime plays when a timer ends</div>
                                    </div>
                                    <div class="stg-row-ctrl">
                                        <div class="stg-segmented">
                                            <button class="stg-seg-btn" data-stg-key="chimeRepeat" data-stg-val="1" onclick="saveSetting('chimeRepeat',1); this.closest('.stg-segmented').querySelectorAll('.stg-seg-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active');">1&times;</button>
                                            <button class="stg-seg-btn" data-stg-key="chimeRepeat" data-stg-val="2" onclick="saveSetting('chimeRepeat',2); this.closest('.stg-segmented').querySelectorAll('.stg-seg-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active');">2&times;</button>
                                            <button class="stg-seg-btn" data-stg-key="chimeRepeat" data-stg-val="3" onclick="saveSetting('chimeRepeat',3); this.closest('.stg-segmented').querySelectorAll('.stg-seg-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active');">3&times;</button>
                                            <button class="stg-seg-btn" data-stg-key="chimeRepeat" data-stg-val="5" onclick="saveSetting('chimeRepeat',5); this.closest('.stg-segmented').querySelectorAll('.stg-seg-btn').forEach(b=>b.classList.remove('active')); this.classList.add('active');">5&times;</button>
                                        </div>
                                    </div>
                                </div>
